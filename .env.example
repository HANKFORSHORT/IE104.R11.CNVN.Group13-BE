# Local development database. Copy to .env and replace placeholders.
NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=astra_dev
DB_PASSWORD=replace_with_local_password
DB_NAME=astra_dev
# For a remote TLS database, set DB_HOST and optionally DB_SSL_CA_PATH.
# DB_SSL_CA_PATH=/absolute/path/to/ca.pem
# Only for an explicitly disposable remote development database:
# ALLOW_REMOTE_DEMO_SEED=1

# Browser origin and page URL. Set these to the actual FE deployment.
FRONTEND_ORIGIN=http://localhost:5500
FRONTEND_URL=http://localhost:5500/
# JWT signing key: replace with at least 32 random bytes (never commit it).
JWT_SECRET=

# Configure each provider independently. Fill its ID, secret and callback URL together.
# OAuth callback URLs must exactly match the developer-console entries.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_SECRET=
# FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v27.0

# SMTP sender for password reset. On Render, set these as environment variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
